# What the libraries delivered in bulk: not in git, can be fetched again
# (addresses and checksums in metadata/sources.csv of each version). Their small records are kept.
works/*/source/*
!works/*/source/*.json
!works/*/source/*_pages.csv

# Intermediate files and results of the conversions: made again by the convert/ scripts
# of each version
works/*/work/
works/*/text/

# Article PDFs: publishers' copyright (listed in references/README.md)
references/*.pdf

# The Python environment, made by "uv sync" (README.md, "Setting up")
.venv/

# Unfinished downloads, Python and editor leftovers
*.part
*.parts/
__pycache__/
*.pyc
.~lock.*
.DS_Store
