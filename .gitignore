# What the libraries delivered in bulk: not in git, can be fetched again
# (sources and checksums in data/Downloads_report.csv). Their small records are kept.
data/*/source/*
!data/*/source/*.json
!data/*/source/*_pages.csv

# Intermediate files and results of the conversions: made again by convert/extract.py
# and convert/repair.py of each version
data/*/work/
data/*/text/

# Article PDFs: publishers' copyright (listed in references/README.md)
references/*.pdf

# The Python environment, made by "uv sync" (README.md, "Setting up")
.venv/

# Unfinished downloads, Python and editor leftovers
*.part
*.parts/
__pycache__/
*.pyc
.~lock.*
.DS_Store
